# Copy this to .env and update values
APP_NAME=primeidpro
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

HOST=0.0.0.0


MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=primeidpro

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

FACE_DETECTION_MODEL=mediapipe
BACKGROUND_MODEL=rembg
ENHANCEMENT_LEVEL=medium
PASSPORT_STANDARD=35x45

SECRET_KEY=change-this-in-production
CORS_ORIGINS=["http://localhost:10000"]

SITE_NAME=primeidpro
SITE_URL=http://localhost:10000
SITE_DESCRIPTION=Free passport size photo generator