# Copy this to .env and update values
APP_NAME=primeidpro
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

HOST=0.0.0.0


MONGODB_URL=
MONGODB_DB_NAME=primeidpro

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

FACE_DETECTION_MODEL=mediapipe
BACKGROUND_MODEL=rembg
ENHANCEMENT_LEVEL=medium
PASSPORT_STANDARD=35x45

SECRET_KEY=change-this-in-production
CORS_ORIGINS=["http://localhost:10000"]

SITE_NAME=primeidpro
SITE_URL=http://localhost:10000
SITE_DESCRIPTION=Free passport size photo generator

# Brevo Transactional Email Configuration
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SMTP_USER=your-brevo-smtp-login@smtp-brevo.com
BREVO_SMTP_PASSWORD=your-brevo-smtp-master-password
MAIL_FROM=no-reply@primeidpro.online
MAIL_FROM_NAME=Prime ID Pro
APP_BASE_URL=https://primeidpro.online

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

